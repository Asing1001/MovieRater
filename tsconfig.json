{
  "compileOnSave": true,
  "compilerOptions": {
    "skipLibCheck": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "commonjs",
    "noEmitOnError": true,
    "noImplicitAny": false,
    "outDir": "dist/",
    "rootDir": "src/",
    "sourceMap": true,
    "target": "es2020",
    "jsx": "react",
    "types": ["mocha", "react-dom"],
    "lib": ["dom", "es2020"]
  }
}
